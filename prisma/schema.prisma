generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Trader {
  id            String   @id @default(cuid())
  proxyWallet   String   @unique
  username      String?
  monthlyPnl    Float    @default(0)
  monthlyVolume Float    @default(0)
  rank          Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RefreshRun {
  id               String                @id @default(cuid())
  status           String                @default("running")
  startedAt        DateTime              @default(now())
  completedAt      DateTime?
  topTraderCount   Int                   @default(0)
  totalPositions   Int                   @default(0)
  failedUsers      Int                   @default(0)
  errorMessage     String?
  positions        PositionSnapshot[]
  marketGroups     MarketPositionGroup[]
}

model PositionSnapshot {
  id           String     @id @default(cuid())
  refreshRunId String
  refreshRun   RefreshRun @relation(fields: [refreshRunId], references: [id], onDelete: Cascade)
  proxyWallet  String
  username     String?
  conditionId  String
  marketTitle  String
  slug         String?
  outcome      String
  category     String?
  currentValue Float      @default(0)
  size         Float      @default(0)
  cashPnl      Float      @default(0)
  volume       Float      @default(0)
  createdAt    DateTime   @default(now())

  @@index([refreshRunId])
  @@index([conditionId])
  @@index([proxyWallet])
}

model MarketPositionGroup {
  id                String     @id @default(cuid())
  refreshRunId      String
  refreshRun        RefreshRun @relation(fields: [refreshRunId], references: [id], onDelete: Cascade)
  conditionId       String
  marketTitle       String
  outcome           String
  category          String?
  holderCount       Int        @default(0)
  totalCurrentValue Float      @default(0)
  totalSize         Float      @default(0)
  totalCashPnl      Float      @default(0)
  avgCashPnl        Float      @default(0)
  totalVolume       Float      @default(0)
  consensusScore    Float      @default(0)
  createdAt         DateTime   @default(now())

  @@index([refreshRunId])
  @@index([conditionId])
}

// ── Small-Cap Stock Models ─────────────────────────────────────────

model Stock {
  id                  String         @id @default(cuid())
  ticker              String         @unique
  name                String
  exchange            String?
  sector              String?
  industry            String?
  description         String?
  marketCap           Float          @default(0)
  price               Float          @default(0)
  change1M            Float          @default(0)
  change3M            Float          @default(0)
  revenueGrowth       Float          @default(0)
  epsGrowth           Float          @default(0)
  analystRating       String?
  analystCount        Int            @default(0)
  bullishScore        Float          @default(0)
  lastEarningsDate    String?
  float               Float?
  shortInterest       Float?
  institutionalOwn    Float?
  insiderBuying       Float          @default(0)
  relativeVolume      Float          @default(0)
  earningsBeat        Boolean        @default(false)
  revenueBeat         Boolean        @default(false)
  guidanceUp          Boolean        @default(false)
  rank                Int            @default(0)

  // Quality/Growth lens
  qualityScore        Float?
  qualityRank         Int?

  // Value/Turnaround lens
  turnaroundScore     Float?
  turnaroundRank      Int?

  // Shared fundamentals (FMP balance-sheet/income/cash-flow) backing both lenses
  netIncome           Float?
  totalDebt           Float?
  cashAndEquivalents  Float?
  freeCashFlow        Float?
  trailingPE          Float?
  priceToBook         Float?

  updatedAt           DateTime       @updatedAt
  createdAt           DateTime       @default(now())
  snapshots           StockSnapshot[]
  news                StockNews[]
  watchlistItems      WatchlistItem[]

  @@index([bullishScore])
  @@index([rank])
  @@index([qualityRank])
  @@index([turnaroundRank])
}

model StockSnapshot {
  id              String   @id @default(cuid())
  ticker          String
  stock           Stock    @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  lens            String   @default("speculative") // "speculative" | "quality" | "turnaround" — a ticker can be snapshotted once per lens per day, so this disambiguates rows instead of relying on which score field is non-null
  bullishScore    Float    @default(0)
  qualityScore    Float?
  turnaroundScore Float?
  price           Float    @default(0)
  marketCap       Float    @default(0)
  createdAt    DateTime @default(now())

  @@index([ticker])
  @@index([lens])
}

model StockNews {
  id          String   @id @default(cuid())
  ticker      String
  stock       Stock    @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  headline    String
  publisher   String?
  publishedAt DateTime?
  url         String
  summary     String?
  sentiment   Float    @default(0)
  createdAt   DateTime @default(now())

  @@index([ticker])
}

model WatchlistItem {
  id            String    @id @default(cuid())
  ticker        String
  stock         Stock     @relation(fields: [ticker], references: [ticker], onDelete: Cascade)
  listName      String    @default("default")
  targetPrice   Float?
  targetScore   Float?
  lastAlertedAt DateTime?
  createdAt     DateTime  @default(now())

  @@unique([ticker, listName])
}

// ── Catalysts (prediction-market -> stock signal engine) ──────────────

// One probability reading for one outcome of one catalyst event, at one
// point in time. Keyed by (eventSlug, outcomeId) — the theme's own stable
// identifiers (lib/catalysts/themes.ts), not the raw Polymarket
// conditionId/outcomeIndex — so a theme can be repointed at a new market
// instance later (e.g. rolling from the August to the September jobs
// report) without orphaning its history under a dead conditionId.
model PredictionMarketSnapshot {
  id          String   @id @default(cuid())
  eventSlug   String
  outcomeId   String
  conditionId String // recorded for debugging/audit, not used as the lookup key
  probability Float
  volume      Float?
  liquidity   Float?
  capturedAt  DateTime @default(now())

  @@index([eventSlug, outcomeId, capturedAt])
}

// One row per (ticker, event) per day — spec Part 23's "start recording
// observations needed to evaluate the model later." This phase is
// recording ONLY: computing 1D/5D/20D/60D returns and excess return vs.
// a benchmark is deliberately NOT done here (spec: "do not attempt to
// optimize the model yet, just make historical testing possible") — that
// requires joining an old observation against a LATER price, which this
// table makes possible but doesn't itself compute.
//
// stockPrice is nullable — never fabricated when a quote isn't available.
// sectorBenchmark is left null for now rather than guessing an ETF for
// tickers without one clean mapping (e.g. staffing firms); marketBenchmark
// is the uncontroversial constant "SPY". Field names (ticker/eventSlug)
// match PredictionMarketSnapshot's naming rather than the spec's own
// symbol/eventId, for consistency within this codebase.
model CatalystObservation {
  id                  String   @id @default(cuid())
  ticker              String
  eventSlug           String
  formulaVersion      String
  currentOutlookScore Float
  catalystChangeScore Float?
  confidence          Float
  stockPrice          Float?
  sectorBenchmark     String?
  marketBenchmark     String?
  observedAt          DateTime @default(now())

  @@index([ticker, eventSlug, observedAt])
}
